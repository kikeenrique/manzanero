#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Generate the probe app Xcode workspace at tmp/probe-app/generated with Tuist (never committed)"
#MISE tools = { tuist = "4.214.0" }

# Tuist always writes the project, workspace and Derived/ next to the manifest
# and has no output-directory option. To keep generated files out of the
# tracked tree without a .gitignore entry, this task copies the manifests into
# tmp/probe-app/generated/ and generates there, pointing them back at the
# tracked sources in Fixtures/ProbeApp through TUIST_PROBE_APP_FIXTURE.
# Local generation only: no Tuist account, server or binary cache.
#
# Optional device signing, read from the environment (mise loads the untracked
# .env.local) and written only to the untracked tmp/probe-app/Signing.xcconfig
# (included by Config/ProbeApp.xcconfig):
#   DEVELOPMENT_TEAM       Apple developer team identifier
#   PROBE_APP_BUNDLE_ID  replaces the tracked default bundle identifier
# When neither is set, an existing Signing.xcconfig is left as it is.

set -euo pipefail

out=tmp/probe-app
generated="$out/generated"
mkdir -p "$generated"

team="${DEVELOPMENT_TEAM:-}"
bundle="${PROBE_APP_BUNDLE_ID:-}"
if [ -n "$team" ] || [ -n "$bundle" ]; then
  if [ -n "$team" ] && ! [[ "$team" =~ ^[A-Z0-9]{10}$ ]]; then
    echo "DEVELOPMENT_TEAM must be a 10-character team identifier" >&2
    exit 1
  fi
  if [ -n "$bundle" ] && ! [[ "$bundle" =~ ^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$ ]]; then
    echo "PROBE_APP_BUNDLE_ID must be a reverse-DNS identifier of letters, digits, hyphens and dots" >&2
    exit 1
  fi
  {
    echo "// Written by mise run probe-app:generate from the environment. Untracked; do not commit."
    if [ -n "$team" ]; then echo "DEVELOPMENT_TEAM = $team"; fi
    if [ -n "$bundle" ]; then echo "PROBE_APP_BUNDLE_ID = $bundle"; fi
  } > "$out/Signing.xcconfig"
  echo "Wrote $out/Signing.xcconfig" >&2
fi

cp Fixtures/ProbeApp/Project.swift Fixtures/ProbeApp/Tuist.swift "$generated/"
# Fixture directory relative to the copied manifest, read by Project.swift.
TUIST_PROBE_APP_FIXTURE=../../../Fixtures/ProbeApp \
  tuist generate --path "$generated" --no-open --cache-profile none
echo "Generated $generated/ProbeApp.xcworkspace and $generated/ProbeApp.xcodeproj" >&2

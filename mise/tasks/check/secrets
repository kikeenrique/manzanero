#!/usr/bin/env bash
#MISE dir = "{{ config_root }}"
#MISE description = "Scan for secrets with Gitleaks: the commits not yet on origin/main, or every commit with --all, and the tracked files"
#MISE tools = { gitleaks = "8.30.1" }
#USAGE flag "--all" help="Scan every reachable commit, not only those after origin/main"
#USAGE flag "--since <revision>" help="Scan the commits after this revision (default: origin/main)"
# Part of the pre-release checks (docs/public-readiness.md). Default rules,
# full redaction; reports stay on this Mac and are never uploaded.
set -euo pipefail

if [ "${usage_all:-false}" = "true" ]; then
  gitleaks git --config .gitleaks.toml --gitleaks-ignore-path .gitleaksignore --redact --no-banner .
elif [ -n "${usage_since:-}" ]; then
  gitleaks git --config .gitleaks.toml --gitleaks-ignore-path .gitleaksignore --log-opts="$usage_since..HEAD" --redact --no-banner .
else
  git fetch --quiet origin main 2>/dev/null || echo "Could not fetch origin; scanning after the local origin/main ($(git rev-parse --short origin/main))." >&2
  gitleaks git --config .gitleaks.toml --gitleaks-ignore-path .gitleaksignore --log-opts="origin/main..HEAD" --redact --no-banner .
fi
work=$(mktemp -d tmp/secrets.XXXXXX)
git archive HEAD | tar -x -C "$work"
gitleaks dir --config .gitleaks.toml --gitleaks-ignore-path .gitleaksignore --redact --no-banner "$work"
rm -rf "$work"

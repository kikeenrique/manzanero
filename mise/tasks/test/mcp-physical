#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Verify MCP stdio physical AX tree for an explicitly selected device and PID"
#MISE depends = ["build"]
#USAGE arg "<device>" help="Explicit physical device UDID"
#USAGE arg "<pid>" help="Current application PID to inspect; may be a background app"

set -e -o pipefail

APPLEDEVICES_MCP_LIVE=1 APPLEDEVICES_MCP_TEST_PHYSICAL="$usage_device" APPLEDEVICES_MCP_TEST_PID="$usage_pid" swift test --cache-path tmp/swift-cache --filter MCPStdioTests 2>&1 | xcsift -f toon

#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Stop MCP during one physical hold and verify bounded cleanup and exit"
#MISE depends = ["build"]
#USAGE arg "<device>" help="Explicit physical device UDID"
#USAGE arg "<x>" help="Normalized x coordinate 0...1"
#USAGE arg "<y>" help="Normalized y coordinate 0...1"
#USAGE arg "<seconds>" help="Hold duration 8...10 seconds; shutdown begins after two seconds"
#USAGE arg "<mode>" help="EOF, SIGINT or SIGTERM; affects only the owned MCP process"

set -e -o pipefail

unset MANZANERO_MCP_CANCEL_GESTURE_FILE
MANZANERO_MCP_LIVE=1 MANZANERO_MCP_TEST_PHYSICAL="$usage_device" MANZANERO_MCP_CANCEL_LONG_PRESS="$usage_x,$usage_y,$usage_seconds" MANZANERO_MCP_TEST_SHUTDOWN="$usage_mode" swift test --cache-path tmp/swift-cache --filter MCPStdioTests 2>&1 | xcsift -f toon --warnings

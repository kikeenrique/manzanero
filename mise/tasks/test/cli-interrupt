#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Interrupt one physical CLI hold with SIGINT or SIGTERM and verify its exit"
#MISE depends = ["build"]
#USAGE arg "<device>" help="Explicit physical device UDID"
#USAGE arg "<x>" help="Normalized x coordinate 0...1"
#USAGE arg "<y>" help="Normalized y coordinate 0...1"
#USAGE arg "<seconds>" help="Hold duration 8...10 seconds; signal is sent after two seconds"
#USAGE arg "<signal>" help="SIGINT or SIGTERM; sent only to the owned CLI child"

set -e -o pipefail

MANZANERO_CLI_INTERRUPT_DEVICE="$usage_device" MANZANERO_CLI_INTERRUPT_HOLD="$usage_x,$usage_y,$usage_seconds" MANZANERO_CLI_INTERRUPT_SIGNAL="$usage_signal" swift test --cache-path tmp/swift-cache --filter CLIInputInterruptionTests 2>&1 | xcsift -f toon --warnings

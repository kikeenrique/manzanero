#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Send one standalone direct multitouch command through real MCP and capture its result"
#MISE depends = ["build"]
#USAGE arg "<device>" help="Explicit physical device UDID"
#USAGE arg "<operation>" help="multi-tap or multi-drag"
#USAGE arg "<operands>" help="Comma-separated normalized coordinates; multi-drag starts with seconds"

set -e -o pipefail

MANZANERO_MCP_LIVE=1 MANZANERO_MCP_TEST_PHYSICAL="$usage_device" MANZANERO_MCP_TEST_MULTITOUCH="$usage_operation,$usage_operands" swift test --cache-path tmp/swift-cache --filter MCPStdioTests 2>&1 | xcsift -f toon --warnings

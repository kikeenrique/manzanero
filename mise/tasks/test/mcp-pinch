#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Send one direct Apple two-contact pinch through real MCP and capture its result"
#MISE depends = ["build"]
#USAGE arg "<device>" help="Explicit physical device UDID"
#USAGE arg "<center_x>" help="Normalized interface x coordinate"
#USAGE arg "<center_y>" help="Normalized interface y coordinate"
#USAGE arg "<start_span>" help="Initial fraction of screen width"
#USAGE arg "<end_span>" help="Final fraction of screen width"
#USAGE arg "<seconds>" help="Gesture duration 0.03...10 seconds; sends one gesture"

set -e -o pipefail

MANZANERO_MCP_LIVE=1 MANZANERO_MCP_TEST_PHYSICAL="$usage_device" MANZANERO_MCP_TEST_PINCH="$usage_center_x,$usage_center_y,$usage_start_span,$usage_end_span,$usage_seconds" swift test --cache-path tmp/swift-cache --filter MCPStdioTests 2>&1 | xcsift -f toon --warnings

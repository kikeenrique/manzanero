#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Read one explicit-PID physical AX tree through native RSD, retaining directory through cleanup"
#USAGE arg "<device>" help="Explicit hardware UDID; uses fresh identity and directory discovery"
#USAGE arg "<pid>" help="Positive application PID; may select a background app, not a foreground guarantee"

set -e -o pipefail

APPLEDEVICES_RSD_TREE_DEVICE="$usage_device" APPLEDEVICES_RSD_TREE_PID="$usage_pid" swift test --cache-path tmp/swift-cache --filter RSDPhysicalTreeTests 2>&1 | xcsift -f toon --warnings

#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Send one native physical long-press through real MCP and capture its result"
#MISE depends = ["build"]
#MISE env = { PATH = "{{ config_root }}/tmp/bin:{{ env.PATH }}" }
#USAGE arg "<device>" help="Explicit physical device UDID"
#USAGE arg "<x>" help="Normalized x coordinate 0...1"
#USAGE arg "<y>" help="Normalized y coordinate 0...1"
#USAGE arg "<seconds>" help="Hold duration 0.1...10 seconds; sends one physical action"

set -e -o pipefail

APPLEDEVICES_MCP_LIVE=1 APPLEDEVICES_MCP_TEST_PHYSICAL="$usage_device" APPLEDEVICES_MCP_TEST_LONG_PRESS="$usage_x,$usage_y,$usage_seconds" swift test --cache-path tmp/swift-cache --filter MCPStdioTests 2>&1 | xcsift -f toon --warnings

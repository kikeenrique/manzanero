#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Verify native Vision OCR completion or cooperative deadline on an explicit local image"
#USAGE arg "<image>" help="Existing local image; no device is queried"
#USAGE flag "--timeout-ms <milliseconds>" default="120000" help="Recognition deadline in milliseconds, up to 300000"
#USAGE flag "--expect-timeout" help="Require a drained deadline error rather than recognition"

set -e -o pipefail

export APPLEDEVICES_OCR_TEST_IMAGE="$usage_image"
export APPLEDEVICES_OCR_TEST_TIMEOUT_MS="$usage_timeout_ms"
if [ "${usage_expect_timeout:-false}" = "true" ]; then
  export APPLEDEVICES_OCR_EXPECT_TIMEOUT=1
else
  unset APPLEDEVICES_OCR_EXPECT_TIMEOUT
fi
swift test --cache-path tmp/swift-cache --filter ScreenTextTests.explicitlySelectedLocalImageUsesNativeVisionWithDeadline 2>&1 | xcsift -f toon --warnings

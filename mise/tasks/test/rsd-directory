#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Probe one native Apple RemoteXPC RSD directory; verify hardware without AX subscription or UI input"
#USAGE arg "<device>" help="Explicit hardware UDID; uses fresh details and exact-address port discovery"

set -e -o pipefail

APPLEDEVICES_RSD_DIRECTORY_DEVICE="$usage_device" swift test --cache-path tmp/swift-cache --filter RSDDirectoryConnectionTests 2>&1 | xcsift -f toon --warnings

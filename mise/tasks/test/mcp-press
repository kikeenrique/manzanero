#MISE description = "Submit one guarded native AX press through real MCP and capture before/after screenshots"
#MISE depends = ["build"]
#USAGE arg "<device>" help="Explicit physical device UDID; awake portrait device"
#USAGE arg "<by>" help="Exact selector kind: identifier or label"

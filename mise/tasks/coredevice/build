#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Build the pinned native CoreDevice helper into tmp/bin"
#MISE depends = ["coredevice:setup"]

set -e -o pipefail

mkdir -p tmp/coredevice-source/Sources
cp tmp/ipb/Sources/* tmp/coredevice-source/Sources/
cp Backends/CoreDevice/multitouch.inc tmp/coredevice-source/Sources/
cp Backends/CoreDevice/gesture.inc tmp/coredevice-source/Sources/
cat tmp/ipb/Sources/universalhid_glue.swift Backends/CoreDevice/raw-report.swift > tmp/coredevice-source/Sources/universalhid_glue.swift
git apply --directory=tmp/coredevice-source Backends/CoreDevice/multitouch.patch
make -C tmp/ipb SOURCES_DIR=../coredevice-source/Sources BUILD_DIR=../coredevice-build check-reports ../coredevice-build/ipb-helper 2>&1 | xcsift -f toon
test -x tmp/coredevice-build/ipb-helper
mkdir -p tmp/bin
cp tmp/coredevice-build/ipb-helper tmp/bin/appledevices-coredevice

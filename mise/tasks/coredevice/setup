#!/usr/bin/env bash
#MISE dir = "{{ config_root }}"
#MISE description = "Fetch the pinned MIT-licensed ipb helper sources under tmp"

set -e -o pipefail

if [ ! -e tmp/ipb ]; then
  git clone --no-checkout --depth 1 https://github.com/ipbtools/ipb.git tmp/ipb
  git -C tmp/ipb fetch --depth 1 origin 8c227a10710dad479852aa0203de729fed57471b
  git -C tmp/ipb checkout --detach 8c227a10710dad479852aa0203de729fed57471b
fi
test "$(git -C tmp/ipb rev-parse HEAD)" = 8c227a10710dad479852aa0203de729fed57471b
git -C tmp/ipb diff --exit-code HEAD

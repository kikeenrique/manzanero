#!/usr/bin/env bash
#MISE extends = "swift"
#MISE description = "Build, ad-hoc sign and smoke-test the Apple silicon macOS beta archive under tmp/dist"
set -euo pipefail

version=$(sed -n 's/^let manzaneroVersion = "\(.*\)"$/\1/p' Sources/Manzanero/Version.swift)
[[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$ ]] || { echo "Invalid release version" >&2; exit 1; }
mkdir -p tmp/dist
work=$(mktemp -d tmp/package.XXXXXX)
destination="$PWD/tmp/dist/$version"
mkdir -p "$destination" "$work/payload/ThirdParty/packages"

# Apple silicon only: every device operation needs Xcode 27 or later, which
# has no Intel build (and needs macOS 26.6 or later), so an x86_64 slice could
# never do anything.
# The prefix maps keep the checkout's absolute path out of the binary: lwIP's
# assertions embed __FILE__, which carried the builder's home directory.
prefix_maps=(-Xcc "-fmacro-prefix-map=$PWD=." -Xswiftc -file-prefix-map -Xswiftc "$PWD=.")
swift build -c release --arch arm64 --product manzanero --force-resolved-versions --cache-path tmp/swift-cache --scratch-path tmp/release-build "${prefix_maps[@]}" 2>&1 | xcsift -f toon --warnings
products=$(swift build -c release --arch arm64 --show-bin-path --scratch-path tmp/release-build "${prefix_maps[@]}")
cp "$products/manzanero" "$work/payload/manzanero"
test "$(xcrun lipo -archs "$work/payload/manzanero")" = "arm64"
mkdir -p "$work/payload/lib"
xcrun swift-stdlib-tool --copy --platform macosx --scan-executable "$work/payload/manzanero" --destination "$work/payload/lib" --sign - --Xcodesign --timestamp=none
# Remove build-host rpaths. Resolve required Swift back-deploy
# libraries beside the executable, both after extraction and in Homebrew libexec.
while IFS= read -r search_path; do
  case "$search_path" in
    /usr/lib/swift|@loader_path) ;;
    *) xcrun install_name_tool -delete_rpath "$search_path" "$work/payload/manzanero" ;;
  esac
done < <(otool -l "$work/payload/manzanero" | awk '/cmd LC_RPATH/{getline; getline; print $2}' | sort -u)
xcrun install_name_tool -add_rpath @loader_path/lib "$work/payload/manzanero"
codesign --force --sign - --timestamp=none "$work/payload/manzanero"
codesign --verify --strict "$work/payload/manzanero"
test "$("$work/payload/manzanero" --version)" = "manzanero $version"
"$work/payload/manzanero" --help > "$work/help.txt"
grep -q 'Apple device tools for terminals and agents' "$work/help.txt"
# Fail on non-system dynamic dependencies or a build-machine path. Apple private
# device frameworks are loaded at runtime and are never copied into the archive.
otool -L "$work/payload/manzanero" > "$work/linkage.txt"
while IFS= read -r dependency; do
  case "$dependency" in
    /System/Library/*|/usr/lib/*) ;;
    @rpath/*) test -f "$work/payload/lib/${dependency#@rpath/}" || { echo "Unbundled runtime: $dependency" >&2; exit 1; } ;;
    *) echo "Non-system dependency: $dependency" >&2; exit 1 ;;
  esac
done < <(awk '/compatibility version/{print $1}' "$work/linkage.txt" | sort -u)
for runtime in "$work/payload/lib/"*.dylib; do
  [ -f "$runtime" ] || continue
  xcrun lipo "$runtime" -verify_arch arm64
  codesign --verify --strict "$runtime"
done

cp ThirdParty/* "$work/payload/ThirdParty/"
cp Package.resolved "$work/payload/ThirdParty/Package.resolved"
for dependency in eventsource swift-argument-parser swift-atomics swift-collections swift-log swift-nio swift-sdk swift-subprocess swift-system; do
  # SPM's resolved sources are the authoritative notices for the linked graph.
  mkdir -p "$work/payload/ThirdParty/packages/$dependency"
  notices=0
  for notice in LICENSE LICENSE.txt LICENSE.md NOTICE NOTICE.txt; do
    path="tmp/release-build/checkouts/$dependency/$notice"
    if [ -f "$path" ]; then
      cp "$path" "$work/payload/ThirdParty/packages/$dependency/"
      notices=$((notices + 1))
    fi
  done
  test "$notices" -gt 0 || { echo "Missing notices for $dependency" >&2; exit 1; }
done
# llhttp's separate MIT notice belongs to the C module linked by SwiftNIO.
mkdir -p "$work/payload/ThirdParty/packages/swift-nio/CNIOLLHTTP"
cp tmp/release-build/checkouts/swift-nio/Sources/CNIOLLHTTP/LICENSE "$work/payload/ThirdParty/packages/swift-nio/CNIOLLHTTP/"
cp docs/beta-testing.md "$work/payload/beta-testing.md"
cp license "$work/payload/license"
cp "$work/linkage.txt" "$destination/linkage.txt"
# One archive, named by its target triple. An archive left by an earlier
# universal build must not reach the checksums or a release.
rm -f "$destination/manzanero-x86_64-apple-darwin.tar.gz"
COPYFILE_DISABLE=1 tar -cf "$work/payload.tar" -C "$work/payload" .
gzip -n -c "$work/payload.tar" > "$destination/manzanero-aarch64-apple-darwin.tar.gz"
(
  cd "$destination"
  shasum -a 256 manzanero-*-apple-darwin.tar.gz > SHA256SUMS
  shasum -a 256 -c SHA256SUMS
)
echo "Packaged $version in $destination (ad-hoc signed; not notarized)"
